<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- The only hardened-runtime exception Electron needs: V8's JIT and WebAssembly
         (the meshopt decoder) compile code at runtime. No network, file, camera,
         microphone or library-validation exceptions. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
