{
  "name": "doctrine-of-war-ash-and-banner",
  "productName": "Doctrine of War",
  "private": true,
  "version": "1.0.1",
  "description": "A doctrine-driven fantasy command game: you never move a soldier, you write their standing orders.",
  "author": "FTL Enterprises",
  "homepage": "https://doctrinegame.ftlenterprises.us",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:mac": "ELECTRON=1 vite",
    "build": "tsc -b && vite build",
    "build:mac": "npm run build && ELECTRON=1 vite build && electron-builder --mac",
    "test": "vitest run --project unit",
    "test:balance": "vitest run --project balance",
    "test:campaign": "vitest run --project campaign",
    "test:watch": "vitest --project unit",
    "balance": "vite-node scripts/balance.ts --",
    "capture": "node scripts/capture.mjs",
    "capture:app": "node scripts/capture-app.mjs",
    "build:orchestra": "node scripts/build-orchestra.mjs",
    "audio:demo": "node scripts/audio-demo.mjs",
    "smoke:field-test": "ELECTRON=1 vite build && electron scripts/smoke-field-test.mjs",
    "smoke:roll-save": "ELECTRON=1 vite build && electron scripts/smoke-roll-save.mjs",
    "smoke:board-clicks": "node scripts/smoke-board-clicks.mjs",
    "fetch:cc0": "node scripts/fetch-cc0.mjs"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "postprocessing": "^6.39.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.0.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^3.0.0"
  }
}
